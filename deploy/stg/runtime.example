# Non-secret template. Install the completed file outside the checkout at
# /etc/opnform/stg/runtime.env, owned by root with mode 0600.
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
APP_KEY=REPLACE_WITH_LARAVEL_APP_KEY
APP_NAME=Venova
FRONT_API_SECRET=REPLACE_WITH_RANDOM_SHARED_SECRET

# Staging uses private local storage on the Hetzner Volume, set in Compose.
# Configure mail before the first start.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=heyactlys@gmail.com
# MAIL_PASSWORD is supplied separately from GitHub staging secret SMTP_PASSWORD.
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=heyactlys@gmail.com
MAIL_FROM_NAME=Venova
